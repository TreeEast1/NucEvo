# OpenModelica compiler & library (required for simulation and physics verification)
NUCEVO_OMC=/path/to/om/bin/omc
OPENMODELICALIBRARY=/path/to/omlibrary

# Local cache directory (simulation cache, embedding cache, HF cache)
NUCEVO_CACHE_DIR=~/.cache/nucevo

# Retrieval encoder (default: BAAI/bge-small-en-v1.5)
NUCEVO_EMBED_MODEL=BAAI/bge-small-en-v1.5

# External reflection teacher API (only needed for scripts/evolve.py; not needed for frozen evaluation)
NUCEVO_TEACHER_BASE_URL=https://api.example.com/v1
NUCEVO_TEACHER_API_KEY=your_api_key_here
NUCEVO_TEACHER_MODEL=your_teacher_model
NUCEVO_TEACHER_MIN_INTERVAL=2.0

# Optional solver tool guards (leave unset for official benchmark reproduction)
# NUCEVO_STRICT_EDIT=0
# NUCEVO_REPEAT_GUARD=0
